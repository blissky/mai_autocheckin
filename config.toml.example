# 自动签到插件配置示例
# Runner 首次加载时会根据 plugin.py 中的 config_model 自动生成 config.toml。
# 本文件仅供参考，不会被插件直接读取。

[plugin]
enabled = true
# 留空则插件绝不调用系统包管理器；仅当精确填写 "我同意自动安装缺失系统库" 时才允许自动安装 Camoufox 系统库
system_deps_consent = ""
config_version = "1.0.0"

[webui]
port = 9010
# 默认仅监听本机；需要从容器或外部访问时改为 "0.0.0.0"
host = "127.0.0.1"
# 重要：请务必将下面的占位密钥改为随机强密钥，否则任何能访问该端口的人都能操作浏览器
token = "sk-change-me"
session_timeout = 30
screenshot_interval = 500

[schedule]
cron_rules = "30 8 * * *"
timezone = "Asia/Shanghai"

[browser]
headless = true
page_load_timeout = 30
action_delay = 1000
checkin_wait = 5
idle_timeout = 10
